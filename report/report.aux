\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces MOPED vs.\ scratch initialisation with AvUC loss. Without warm-starting, AvUC collapses the posterior onto a linear boundary (b,d); with MOPED the non-linear crescent structure is recovered (a,c).}}{10}{figure.caption.27}\protected@file@percent }
\newlabel{fig:bnn_boundaries}{{2}{10}{MOPED vs.\ scratch initialisation with AvUC loss. Without warm-starting, AvUC collapses the posterior onto a linear boundary (b,d); with MOPED the non-linear crescent structure is recovered (a,c)}{figure.caption.27}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Probability histograms and reliability diagrams. (a) BBB/MOPED/AvUC is the sharpest model; (b) its reliability is roughly diagonal but noisy; (c) the failure case has a broad, flat histogram; (d) BBB/MOPED/ELBO traces the diagonal most faithfully.}}{11}{figure.caption.28}\protected@file@percent }
\newlabel{fig:bnn_histrel}{{3}{11}{Probability histograms and reliability diagrams. (a) BBB/MOPED/AvUC is the sharpest model; (b) its reliability is roughly diagonal but noisy; (c) the failure case has a broad, flat histogram; (d) BBB/MOPED/ELBO traces the diagonal most faithfully}{figure.caption.28}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces OOD epistemic uncertainty (mutual information) for two BBB variants. High values along the decision boundary indicate uncertainty about the class boundary; all OOD corner clusters (crosses) remain near zero, confirming posterior collapse outside the training region.}}{12}{figure.caption.29}\protected@file@percent }
\newlabel{fig:bnn_ood}{{4}{12}{OOD epistemic uncertainty (mutual information) for two BBB variants. High values along the decision boundary indicate uncertainty about the class boundary; all OOD corner clusters (crosses) remain near zero, confirming posterior collapse outside the training region}{figure.caption.29}{}}
